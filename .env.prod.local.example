# .env.prod.local.example
# Template pour vos variables d'environnement de production
# Copier ce fichier en .env.prod.local sur le serveur et remplacer les valeurs

# Génération de secrets forts:
# APP_SECRET: openssl rand -hex 32
# MYSQL passwords: openssl rand -base64 32

APP_SECRET=REMPLACER_PAR_SECRET_GENERE_64_CARACTERES_HEX
DATABASE_URL="mysql://jarvis_user:REMPLACER_PAR_MOT_DE_PASSE_FORT@my_database:3306/jarvis?serverVersion=5.7"
MYSQL_ROOT_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_ROOT_FORT
MYSQL_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_FORT
