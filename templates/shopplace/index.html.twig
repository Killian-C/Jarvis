{% extends 'base.html.twig' %}
{% from 'shared/tableActionsMacro.html.twig' import table_actions %}

{% block title %}Liste des lieux d'achat{% endblock %}

{% block body %}
    <a class="p-3" href="{{ path('aliment_index') }}">Retour à la liste des aliments</a>
    <h3 class="text-center my-4 text-primary-blue">Liste des lieux d'achat</h3>
    <div class="text-center">
        <a class="btn btn-primary-blue" href="{{ path('shopplace_new') }}"><i class="fas fa-plus"></i> Lieu d'achat</a>
    </div>
    <div class="container mt-3">
            <table class="table table-striped table-hover table-bordered">
                <thead>
                <tr>
                    <th>Nom</th> <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for shopplace in shopplaces %}
                    <tr>
                        <td>{{ shopplace.name }}</td>
                        <td>
                            {{ table_actions( path('shopplace_edit', {'id': shopplace.id}), path('shopplace_delete', {'id': shopplace.id})) }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">Pas de lieux d'achats enregistrés</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
    </div>
{% endblock %}
