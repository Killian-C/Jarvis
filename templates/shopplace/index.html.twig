{% extends 'base.html.twig' %}
{% from 'shared/tableActionsMacro.html.twig' import table_actions %}
{% from 'shared/titleAndNewActionMacro.html.twig' import title_and_new_action %}

{% block title %}Liste des lieux d'achat{% endblock %}

{% block body %}
    <a class="p-3" href="{{ path('aliment_index') }}">Retour aux aliments</a>
    <div class="container">
        {{ title_and_new_action('Lieux d\'achats', path('shopplace_new')) }}
        <table class="table table-striped table-hover table-bordered">
                <thead>
                <tr>
                    <th>Nom</th> <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for shopplace in shopplaces %}
                    <tr>
                        <td>{{ shopplace.name }}</td>
                        <td>
                            {{ table_actions( path('shopplace_edit', {'id': shopplace.id}), path('shopplace_delete', {'id': shopplace.id})) }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">Pas de lieux d'achats enregistrés</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
    </div>
{% endblock %}
