{% extends 'base.html.twig' %}

{% block title %}Créer un lieu d'achat{% endblock %}
{% form_theme form 'bootstrap_4_layout.html.twig' %}
{% block body %}
    <a class="p-3" href="{{ path('shopplace_index') }}">Retour aux lieux d'achat</a>
    <h4 class="text-center my-4 text-primary-blue">
        {% block title_form %}Ajouter un lieu d'achat{% endblock %}
    </h4>
    <div class="container">
        {{ form_start(form) }}
        {{ form_row(form.name) }}
        <div class="text-center"><input class="btn btn-tertiary" type="submit" value="{% block text_button %}Ajouter{% endblock %}"></div>
        {{ form_end(form) }}
    </div>
{% endblock %}
