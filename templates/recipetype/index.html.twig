{% extends 'base.html.twig' %}
{% from 'shared/tableActionsMacro.html.twig' import table_actions %}
{% from 'shared/titleAndNewActionMacro.html.twig' import title_and_new_action %}

{% block title %}Liste des types de recette{% endblock %}

{% block body %}
    <a class="p-3" href="{{ path('recipe_index') }}">Retour aux recettes</a>
    <div class="container">
        {{ title_and_new_action('Types de recettes', path('recipetype_new')) }}
        <table class="table table-striped table-hover table-bordered mt-4">
            <thead>
            <tr>
                <th>Types de recette</th> <th class="text-center">Actions</th>
            </tr>
            </thead>
            <tbody class="list">
            {% for recipetype in recipetypes %}
                <tr>
                    <td class="name">{{ recipetype.name }}</td>
                    <td>
                        {{ table_actions(path('recipetype_edit', {'id': recipetype.id}), path('recipetype_delete', {'id': recipetype.id})) }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
