{% extends 'base.html.twig' %}
{% from 'shared/tableActionsMacro.html.twig' import table_actions %}

{% block title %}Unit index{% endblock %}

{% block body %}
    <a class="p-3" href="{{ path('aliment_index') }}">Retour à la liste des aliments</a>
    <h2 class="text-center pt-2 text-primary-blue">Unités</h2>
<div class="container">
    <div class="text-center my-4">
        <a class="btn btn-primary-blue" href="{{ path('unit_new') }}"><i class="fas fa-plus"></i> Unités</a>
    </div>
    <table class="table table-striped table-hover table-bordered">
        <thead>
            <tr>
                <th>Nom</th> <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for unit in units %}
            <tr>
                <td>{{ unit.name }}</td>
                <td>
                    {{ table_actions(path('unit_edit', {'id': unit.id}), path('unit_delete', {'id': unit.id})) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Pas d'unités enregirstrées</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
