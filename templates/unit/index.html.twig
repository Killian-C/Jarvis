{% extends 'base.html.twig' %}
{% from 'shared/tableActionsMacro.html.twig' import table_actions %}
{% from 'shared/titleAndNewActionMacro.html.twig' import title_and_new_action %}

{% block title %}Unit index{% endblock %}

{% block body %}
<a class="p-3" href="{{ path('aliment_index') }}">Retour aux aliments</a>
<div class="container">
    {{ title_and_new_action('Unités', path('unit_new')) }}
    <table class="table table-striped table-hover table-bordered">
        <thead>
            <tr>
                <th>Nom</th> <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for unit in units %}
            <tr>
                <td>{{ unit.name }}</td>
                <td>
                    {{ table_actions(path('unit_edit', {'id': unit.id}), path('unit_delete', {'id': unit.id})) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Pas d'unités enregirstrées</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
