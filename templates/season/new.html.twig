{% extends 'base.html.twig' %}

{% block title %}Créer une nouvelle saison{% endblock %}
{% form_theme form 'bootstrap_4_layout.html.twig' %}
{% block body %}
    <a class="p-3" href="{{ path('season_index') }}">Retour aux saisons</a>
    <div class="container">
        <h4 class="text-center text-primary-blue my-4">
            {% block title_form %}Ajouter une nouvelle saison{% endblock %}
        </h4>
        {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.start_date) }}
        {{ form_row(form.end_date) }}
        <div class="text-center"><input class="btn btn-tertiary" type="submit" value="{% block text_button %}Ajouter{% endblock %}"></div>
        {{ form_end(form) }}
    </div>
{% endblock %}
