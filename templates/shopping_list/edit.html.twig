{% extends 'base.html.twig' %}

{% block title %}Liste de courses - Mise à jour{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('listItemEmbedForm') }}
{% endblock %}
{% form_theme form 'bootstrap_4_layout.html.twig' %}

{% block body %}
    <a class="ml-2" href="{{ path('shopping_list_index') }}">Retour à la liste</a>
    <div class="container">
        <h4 class="text-primary-blue text-center my-4">Liste de course</h4>
    </div>
    <div class="shopping-list container p-2 alert alert-warning d-flex justify-content-around align-items-center text-center">
        {{ form_start(form) }}
        <ul class="p-0" id="list-items-container" data-prototype="{{ form_widget(form.listItems.vars.prototype)|e('html_attr') }}" >
            {% for listItem in form.listItems %}
                <li class="d-flex flex-column justify-content-around align-items-start mb-1">
                    <div class="d-flex align-items-center w-100 mb-1">
                        {{ form_row(listItem.checked) }}
                        {{ form_widget(listItem.content) }}
                    </div>
                    <div class="d-flex">
                        {{ form_row(listItem.quantity) }}
                        {{ form_widget(listItem.shopPlace) }}
                    </div>
                </li>
            {% endfor %}
        </ul>
        <div class="d-flex justify-content-around align-items-center w-100">
            <button id="add-list-item" type="button" class="justify-content-center d-flex align-items-center add_item_link btn btn-outline-yellow-dark btn-sm" data-collection-holder-class="listItems">
                <i class="fas fa-plus"></i>
            </button>
        </div>
        <div class="text-center mt-4"><input class="btn btn-yellow text-yellow-dark" type="submit" value="Mettre à jour"></div>
        {{ form_end(form) }}
    </div>
{% endblock %}
