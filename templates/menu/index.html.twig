{% extends 'base.html.twig' %}
{% from 'shared/tableActionsMacro.html.twig' import table_actions %}
{% from 'shared/titleAndNewActionMacro.html.twig' import title_and_new_action %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('accordionMenu') }}
    {{ encore_entry_script_tags('menuIsFavoriteActionAjax') }}
{% endblock %}

{% block title %}Menus{% endblock %}

{% block body %}
    <div class="container">
        {{ title_and_new_action('Menus', path('menu_new')) }}
        <div class="text-center mb-4">
            <form action="{{ path('menu_index_favorites') }}" method="post" class="mx-2">
                <button class="btn btn-light btn-outline-primary text-primary"><i class="fas fa-star"></i> Favoris</button>
            </form>
        </div>
    </div>
    <div class="container" id="menu-container">
        <div class="justify-content-center">
            {% for month_year, menus in month_year_menus %}
                <div id="accordion{{ month_year|replace({' ': '_'}) }}">
                    <div class="accordion-menu alert alert-info d-flex justify-content-between"
                         data-toggle="collapse"
                         data-target="#collapse{{ month_year|replace({' ': '_'}) }}"
                         aria-expanded="true"
                         aria-controls="collapse{{ month_year|replace({' ': '_'}) }}"
                    >
                        <div>{{ month_year|capitalize }}</div>
                        <div class="accordion-menu-arrow {{ loop.index == 1 ? 'active-arrow' : '' }}"><i class="fas fa-sort-down"></i></div>
                    </div>

                    <div data-parent="#accordion{{ month_year|replace({' ': '_'}) }}"
                         id="collapse{{ month_year|replace({' ': '_'}) }}"
                         class="collapse {{ loop.index == 1 ? 'show' : '' }}"
                    >
                        {% for menu in menus %}
                                <div class="alert alert-primary d-flex align-items-center justify-content-around">
                                    <div class="text-primary js-favorite-box" id="favorite-menu-{{ menu.id}}-action" data-menu-id="{{ menu.id }}" data-menu-is-favorite="{{ menu.isFavorite ? '1' : '0' }}">
                                        {% if menu.isFavorite %}
                                            ⭐
                                        {% else %}
                                            <i class="far fa-star"></i>
                                        {% endif %}
                                    </div>
                                    <a class="text-primary-blue" href="{{ path('menu_show', {'id': menu.id}) }}">
                                        <i class="fas fa-table"></i>
                                        Menu n°{{ menu.id }} <br>
                                        du {{ menu.startedAt|date("d/m/Y") }} <br>
                                        au {{ menu.finishedAt|date("d/m/Y") }}
                                    </a>
                                    {{ table_actions(path('menu_edit', {'id': menu.id}), path('menu_delete', {'id': menu.id})) }}
                                </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
