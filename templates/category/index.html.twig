{% extends 'base.html.twig' %}
{% from 'shared/tableActionsMacro.html.twig' import table_actions %}
{% from 'shared/titleAndNewActionMacro.html.twig' import title_and_new_action %}

{% block title %}Liste des categories d'aliment{% endblock %}

{% block body %}
<a class="p-3" href="{{ path('aliment_index') }}">Retour aux aliments</a>
<div class="container text-center">
    {{ title_and_new_action('Catégories', path('category_new')) }}
    <table class="table table-striped table-hover table-bordered">
        <thead>
        <tr>
            <th>Catégorie</th> <th class="text-center">Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>
                    {{ category.name }}
                </td>
                <td>
                    {{ table_actions(path('category_edit', {'id': category.id}), path('category_delete', {'id': category.id})) }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
