{% extends 'base.html.twig' %}
{% from 'shared/tableActionsMacro.html.twig' import table_actions %}

{% block title %}Liste des categories d'aliment{% endblock %}

{% block body %}
<a class="p-3" href="{{ path('aliment_index') }}">Retour à la liste des aliments</a>
<h2 class="text-center py-2 text-primary-blue">Catégories d'aliment</h2>
<div class="container text-center">
    <a href="{{ path('category_new') }}" class="btn btn-primary-blue my-3">Ajouter une catégorie</a>
    <table class="table table-striped table-hover table-bordered">
        <thead>
        <tr>
            <th>Catégorie</th> <th class="text-center">Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>
                    {{ category.name }}
                </td>
                <td>
                    {{ table_actions(path('category_edit', {'id': category.id}), path('category_delete', {'id': category.id})) }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
