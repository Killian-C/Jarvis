{% extends 'base.html.twig' %}

{% block title %}Nouvelle catégorie d'aliment{% endblock %}

{% block body %}
<a class="ml-2" href="{{ path('category_index') }}">Retour aux catégories</a>
<div class="container">
    <h4 class="text-center my-4 text-primary-blue">
        {% block title_form %}Ajouter une catégorie{% endblock %}
    </h4>
</div>
<div class="container text-center my-5">
    {{ form_start(form) }}
    <div>{{ form_label(form.name) }}</div>
    <div>{{ form_widget(form.name) }}</div>
    <div class="text-danger pt-2">{{ form_errors(form.name) }}</div>
    <button class="btn btn-tertiary my-3" type="submit">{% block text_button %}Ajouter{% endblock %}</button>
    {{ form_end(form) }}
</div>
{% endblock %}
