{% extends 'base.html.twig' %}

{% block title %}Nouvelle Recette{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('ingredientEmbedForm') }}
{% endblock %}
{% form_theme form 'bootstrap_4_layout.html.twig' %}
{% block body %}
    <div class="container">
        <a href="{{ path('recipe_index') }}">Retour aux recettes</a>
        <h4 class="text-center text-primary-blue mt-2">
            {% block title_form %}Ajouter une recette{% endblock %}
        </h4>
        <p class="font-weight-bold text-center small text-secondary-dark">Toutes les recettes doivent être écrites pour 1 personne</p>

        {{ form_start(form) }}
        <div class="form-box">
            {{ form_row(form.title) }}
            {{ form_row(form.recipeType) }}
            {{ form_row(form.duration) }}
            {{ form_row(form.season) }}
            {{ form_row(form.description) }}
            <p class="ingredients-list">Liste des ingrédients :</p>
            <ul id="ingredients-container" data-async-ingredients-url="{{ path('aliment_async_search') }}"class="ingredients" data-prototype="{{ form_widget(form.ingredients.vars.prototype)|e('html_attr') }}">
                {% for ingredient in form.ingredients %}
                    <li class="recipe-new-ingredients-card">
                        {{ form_widget(ingredient) }}
                    </li>
                {% endfor %}
            </ul>
            <button id="add-ingredient" type="button" class="add_item_link btn btn-sm btn-outline-primary-blue" data-collection-holder-class="ingredients">Ajouter ingrédient</button>
        </div>
        <div class="text-center my-5">
            <input class="btn btn-tertiary p-3" type="submit" value="{% block text_button %}Ajouter{% endblock %}">
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}