{% extends 'base.html.twig' %}

{% block title %}Liste des recettes{% endblock %}
{% from 'shared/tableActionsMacro.html.twig' import table_actions %}

{% block body %}
    <h3 class="text-primary-blue text-center my-4">Liste des recettes</h3>
    <div class="text-center">
        <a class="my-2 btn btn-primary-blue" href="{{ path('recipe_new') }}"><i class="fas fa-plus"></i> Recette</a><br>
        <a class="my-2 btn btn-primary text-dark" href="{{ path('recipetype_index') }}"><i class="fas fa-tag"></i> Types de recette</a>
        <a class="my-2 btn btn-primary text-dark" href="{{ path('season_index') }}"><i class="fas fa-cloud-sun"></i> Saisons</a>
    </div>
    <div class="container mt-4">
        <table class="table table-blue table-striped table-hover table-bordered">
            <thead>
            <tr>
                <th>Recette</th> <th>Type</th> <th class="text-center">Actions</th>
            </tr>
            </thead>
            <tbody class="list">
            {% for recipe in recipes %}
                <tr>
                    <td class="title">
                        <span class="font-weight-bold text-dark">{{ recipe.title }}</span><br>
                        <div class="small text-primary mt-1 text-primary-blue">
                            <i class="fas fa-cloud-sun"></i> {{ recipe.season.name }}<br>
                            <i class="fas fa-clock"></i> {{ constant('App\\Entity\\Recipe::RECIPE_DURATION_TEXT')[recipe.duration] }}
                        </div>
                    </td>
                    <td class="type text-dark">{{ recipe.recipeType.name }}</td>
                    <td>
                        {{ table_actions(path('recipe_edit', {'id': recipe.id}), path('recipe_delete', {'id': recipe.id})) }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
