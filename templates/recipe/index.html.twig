{% extends 'base.html.twig' %}
{% from 'shared/tableActionsMacro.html.twig' import table_actions %}
{% from 'shared/titleAndNewActionMacro.html.twig' import title_and_new_action %}

{% block title %}Liste des recettes{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('recipeTableSearchFilter') }}
{% endblock %}

{% block body %}
    <div class="container">
        {{ title_and_new_action('Recettes', path('recipe_new')) }}
        <div class="text-center">
            <a class="my-2 btn btn-primary text-dark" href="{{ path('recipetype_index') }}"><i class="fas fa-tag"></i> Types de recette</a>
            <a class="my-2 btn btn-primary text-dark" href="{{ path('season_index') }}"><i class="fas fa-cloud-sun"></i> Saisons</a>
        </div>
    </div>
    <div id="recipes" class="container mt-4">
        <div class="d-flex flex-column flex-sm-row m-2">
            <label>
                <input type="text" class="form-control search" placeholder="Rechercher recette..." />
            </label>
            <select class="form-control w-auto ml-sm-2" id="recipe-type-filters">
                <option value="">-- Aucun filtre --</option>
                {% for recipeType in recipe_types %}
                    <option value="{{ recipeType.name }}">{{ recipeType.name }}</option>
                {% endfor %}
            </select>
        </div>
        <table class="table table-blue table-striped table-hover table-bordered">
            <thead>
            <tr>
                <th>Recette</th> <th>Type</th> <th class="text-center">Actions</th>
            </tr>
            </thead>
            <tbody class="list">
            {% for recipe in recipes %}
                <tr>
                    <td class="title">
                        <a href="{{ path('recipe_show', {'id': recipe.id}) }}" class="font-weight-bold text-dark">{{ recipe.title }}</a><br>
                        <div class="small text-primary mt-1 text-primary-blue">
                            {{ recipe.season.name }}<br>
                            {{ constant('App\\Entity\\Recipe::RECIPE_DURATION_TEXT')[recipe.duration] }}
                        </div>
                    </td>
                    <td class="type text-dark">{{ recipe.recipeType.name }}</td>
                    <td>
                        {{ table_actions(path('recipe_edit', {'id': recipe.id}), path('recipe_delete', {'id': recipe.id})) }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
