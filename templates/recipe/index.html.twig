{% extends 'base.html.twig' %}

{% block title %}Liste des recettes{% endblock %}

{% block body %}
    <h4 class="text-dark text-center py-2">Liste des recettes</h4>
{#    <div class="text-center">#}
{#        <a class="my-3 btn btn-secondary" href="{{ path('recipe_new') }}">Rédiger une nouvelle recette</a>#}
{#        <a class="my-3 btn btn-secondary" href="{{ path('recipetype_index') }}">Gérer les types de recette</a>#}
{#        <a class="my-3 btn btn-secondary" href="{{ path('season_index') }}">Gérer les saisons</a>#}
{#    </div>#}
    <div class="text-center">
        <a class="my-3 btn btn-secondary" href="{{ path('recipe_new') }}"><i class="fas fa-plus"></i> Recette</a>
        <a class="my-3 btn btn-secondary" href="{{ path('recipetype_index') }}"><i class="fas fa-tag"></i> Types de recette</a>
        <a class="my-3 btn btn-secondary" href="{{ path('season_index') }}"><i class="fas fa-sun"></i> Saisons</a>
    </div>
    <div class="container">
        <div class="row justify-content-center">
            {% for recipe in recipes %}
                <a class="col-11 col-sm-4 recipe-box alert alert-primary mx-2 d-flex align-items-center justify-content-between" href="{{ path('recipe_show', {'id': recipe.id}) }}">
                    <div>
                        <i class="fas fa-utensils mr-2"></i>
                        {{ recipe.title }}
                    </div>
                    <div class="d-flex align-items-center">
                        <form action="{{ path('recipe_edit', {'id': recipe.id}) }}" method="post" class="ml-3">
                            <button class="btn btn-outline-dark border-0"><i class="fas fa-pen"></i></button>
                        </form>
                        <form action="{{ path('recipe_delete', {'id': recipe.id}) }}" method="post" class="ml-3">
                            <button class="btn btn-outline-secondary-dark border-0"><i class="fas fa-trash"></i></button>
                        </form>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
{% endblock %}
