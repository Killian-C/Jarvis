# Dockerfile.caprover - Pour déploiement Caprover
# Image combinée PHP-FPM + Nginx

FROM php:8.1-fpm

# Configuration PHP pour la production
RUN echo "display_errors = Off" >> /usr/local/etc/php/php.ini-production \
    && echo "log_errors = On" >> /usr/local/etc/php/php.ini-production \
    && cp /usr/local/etc/php/php.ini-production /usr/local/etc/php/php.ini

# Installer les dépendances système + nginx + supervisor
RUN apt-get update && apt-get install -y \
    libzip-dev \
    libpng-dev \
    libjpeg-dev \
    libxml2-dev \
    libicu-dev \
    gnupg \
    nginx \
    supervisor \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Installer les extensions PHP
RUN docker-php-ext-configure zip
RUN docker-php-ext-install -j$(nproc) zip
RUN docker-php-ext-install -j$(nproc) pdo_mysql opcache intl
RUN docker-php-ext-configure gd
RUN docker-php-ext-install -j$(nproc) gd \
    && rm -rf /var/lib/php/*

# Installer Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Définir le répertoire de travail
WORKDIR /var/www/symfony

# Copier et installer les dépendances PHP
COPY composer.json composer.lock ./
RUN composer install \
    --ignore-platform-reqs \
    --no-interaction \
    --no-plugins \
    --no-scripts \
    --prefer-dist \
    --quiet

# Installer Node.js 18 LTS et Yarn
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash -
RUN apt-get install -y nodejs
RUN npm install -g yarn

# Copier tous les fichiers de l'application
COPY . .

# Installer les dépendances JS et compiler les assets
RUN yarn install
ENV NODE_OPTIONS=--openssl-legacy-provider
RUN yarn encore production

# Copier la configuration nginx
COPY docker/nginx-caprover.conf /etc/nginx/sites-available/default

# Copier la configuration supervisor
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Permissions sur les dossiers Symfony
RUN mkdir -p /var/www/symfony/var/cache /var/www/symfony/var/log
RUN chown -R www-data:www-data /var/www/symfony/var /var/www/symfony/public

# Exposer le port 80 (requis par Caprover)
EXPOSE 80

# Démarrer supervisor (gère nginx + php-fpm)
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
