# .env.prod - Configuration PRODUCTION
# NE PAS VERSIONNER CE FICHIER
# Copier ce fichier en .env.prod.local sur le serveur et remplacer les valeurs

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
# Générer avec: php bin/console secrets:generate-keys OU openssl rand -hex 32
APP_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_HERE
###< symfony/framework-bundle ###

###> symfony/mailer ###
# MAILER_DSN=smtp://localhost
###< symfony/mailer ###

###> doctrine/doctrine-bundle ###
# IMPORTANT: Remplacer par un mot de passe fort et unique
# Exemple: openssl rand -base64 32
DATABASE_URL="mysql://jarvis_user:CHANGE_ME_STRONG_PASSWORD@my_database:3306/jarvis?serverVersion=5.7"
###< doctrine/doctrine-bundle ###
